<ui:FluentWindow
    x:Class="SolapiSender.UserApp.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="clr-namespace:SolapiSender.UserApp.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:SolapiSender.UserApp.Views.Pages"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SolapiSender.UserApp.ViewModels"
    Title="{Binding Title}"
    Width="1360"
    Height="860"
    MinWidth="1100"
    MinHeight="680"
    d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
    ExtendsContentIntoTitleBar="True"
    FontFamily="{DynamicResource AppFont}"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="TitleBar"
            Title="{Binding Title}"
            Grid.Row="0">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Chat24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            OpenPaneLength="248"
            PaneDisplayMode="Left">

            <ui:NavigationView.PaneHeader>
                <Border
                    Margin="12,4,12,12"
                    Padding="12,10"
                    Visibility="{Binding IsPaneOpen, ElementName=RootNavigation, Converter={StaticResource BoolToVisibility}}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,8,0" Symbol="BuildingShop24" />
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{Binding StoreName}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding ExpiryText}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </ui:NavigationView.PaneHeader>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    x:Name="NavDashboard"
                    Content="{l:Loc Nav_Dashboard}"
                    Icon="{ui:SymbolIcon Home24}"
                    TargetPageType="{x:Type pages:DashboardPage}" />
                <ui:NavigationViewItem
                    Content="{l:Loc Nav_BulkSend}"
                    Icon="{ui:SymbolIcon Send24}"
                    TargetPageType="{x:Type pages:BulkSendPage}" />
                <ui:NavigationViewItem
                    Content="{l:Loc Nav_SenderNumbers}"
                    Icon="{ui:SymbolIcon Phone24}"
                    TargetPageType="{x:Type pages:SenderNumbersPage}" />
                <ui:NavigationViewItem
                    Content="{l:Loc Nav_Templates}"
                    Icon="{ui:SymbolIcon DocumentText24}"
                    TargetPageType="{x:Type pages:TemplatesPage}" />
                <ui:NavigationViewItem
                    Content="{l:Loc Nav_History}"
                    Icon="{ui:SymbolIcon History24}"
                    TargetPageType="{x:Type pages:HistoryPage}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="{l:Loc Nav_Settings}"
                    Icon="{ui:SymbolIcon Settings24}"
                    TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>

            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="SnackbarPresenter" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <ContentPresenter x:Name="RootContentDialog" Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
