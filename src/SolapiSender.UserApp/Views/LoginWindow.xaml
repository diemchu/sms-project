<ui:FluentWindow
    x:Class="SolapiSender.UserApp.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="clr-namespace:SolapiSender.UserApp.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SolapiSender.UserApp.ViewModels"
    Title="SMS_DiemDev"
    Width="920"
    Height="580"
    d:DataContext="{d:DesignInstance vm:LoginViewModel}"
    ExtendsContentIntoTitleBar="True"
    FontFamily="{DynamicResource AppFont}"
    ResizeMode="CanMinimize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Khối thương hiệu  -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#2B5BE3" />
                    <GradientStop Offset="1" Color="#7B3FE4" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="40,56,40,32">
                <StackPanel VerticalAlignment="Top">
                    <Border
                        Width="56"
                        Height="56"
                        HorizontalAlignment="Left"
                        Background="#33FFFFFF"
                        CornerRadius="14">
                        <ui:SymbolIcon
                            FontSize="30"
                            Foreground="White"
                            Symbol="Chat24" />
                    </Border>
                    <TextBlock
                        Margin="0,28,0,0"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="SMS_DiemDev" />
                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="15"
                        Foreground="#E6FFFFFF"
                        LineHeight="24"
                        Text="{l:Loc Login_Tagline}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom">
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <ui:SymbolIcon Foreground="White" Symbol="People24" />
                        <TextBlock Margin="10,0,0,0" Foreground="#E6FFFFFF" Text="{l:Loc Login_Feature1}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <ui:SymbolIcon Foreground="White" Symbol="CalendarClock24" />
                        <TextBlock Margin="10,0,0,0" Foreground="#E6FFFFFF" Text="{l:Loc Login_Feature2}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Foreground="White" Symbol="Megaphone24" />
                        <TextBlock Margin="10,0,0,0" Foreground="#E6FFFFFF" Text="{l:Loc Login_Feature3}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Form đăng nhập  -->
        <Grid Grid.Column="1">
            <ui:TitleBar
                Title=""
                VerticalAlignment="Top"
                ShowMaximize="False" />

            <ComboBox
                Width="130"
                Margin="0,44,24,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                SelectedValue="{Binding Language}"
                SelectedValuePath="Tag">
                <ComboBoxItem Content="한국어" Tag="ko" />
                <ComboBoxItem Content="Tiếng Việt" Tag="vi" />
            </ComboBox>

            <StackPanel
                Width="340"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitle}" Text="{l:Loc Login_Title}" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:Loc Login_Subtitle}" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Login_Email}" />
                <ui:TextBox
                    Margin="0,0,0,14"
                    Icon="{ui:SymbolIcon Mail24}"
                    PlaceholderText="name@example.com"
                    Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Login_Password}" />
                <ui:PasswordBox
                    x:Name="PasswordInput"
                    Margin="0,0,0,10"
                    Icon="{ui:SymbolIcon LockClosed24}"
                    PasswordChanged="OnPasswordChanged" />

                <CheckBox
                    Margin="0,0,0,16"
                    Content="{l:Loc Login_Remember}"
                    IsChecked="{Binding RememberMe}" />

                <ui:InfoBar
                    Margin="0,0,0,12"
                    IsClosable="False"
                    IsOpen="{Binding ErrorMessage, Converter={StaticResource HasText}, Mode=OneWay}"
                    Message="{Binding ErrorMessage}"
                    Severity="Error" />

                <ui:Button
                    Height="40"
                    HorizontalAlignment="Stretch"
                    Appearance="Primary"
                    Command="{Binding LoginCommand}"
                    IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <ui:ProgressRing
                            Width="16"
                            Height="16"
                            Margin="0,0,8,0"
                            IsIndeterminate="True"
                            Visibility="{Binding LoginCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{l:Loc Login_Button}" />
                    </StackPanel>
                </ui:Button>

                <TextBlock
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource Caption}"
                    Text="{l:Loc Login_Help}" />
            </StackPanel>

            <TextBlock
                Margin="0,0,20,14"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Style="{StaticResource Caption}"
                Text="{Binding Version}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
