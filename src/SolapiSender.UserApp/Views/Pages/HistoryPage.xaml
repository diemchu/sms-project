<Page
    x:Class="SolapiSender.UserApp.Views.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="clr-namespace:SolapiSender.UserApp.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SolapiSender.UserApp.ViewModels.Pages"
    d:DataContext="{d:DesignInstance vm:HistoryViewModel}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:Loc History_Title}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:Loc History_Subtitle}" />
        </StackPanel>

        <!--  Bộ lọc  -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <WrapPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc History_From}" />
                    <DatePicker Width="150" SelectedDate="{Binding StartDate}" SelectedDateFormat="Short" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc History_To}" />
                    <DatePicker Width="150" SelectedDate="{Binding EndDate}" SelectedDateFormat="Short" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Col_Status}" />
                    <ComboBox
                        Width="140"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding StatusOptions}"
                        SelectedItem="{Binding StatusFilter}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Col_Phone}" />
                    <ui:TextBox
                        Width="170"
                        Icon="{ui:SymbolIcon Search24}"
                        PlaceholderText="{l:Loc History_PhoneHint}"
                        Text="{Binding PhoneFilter, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <ui:Button
                    Margin="0,0,8,0"
                    VerticalAlignment="Bottom"
                    Appearance="Primary"
                    Command="{Binding SearchCommand}"
                    Content="{l:Loc History_Search}"
                    Icon="{ui:SymbolIcon Search24}" />
                <ui:Button
                    VerticalAlignment="Bottom"
                    Command="{Binding ExportCommand}"
                    Content="{l:Loc Common_ExportExcel}"
                    Icon="{ui:SymbolIcon ArrowDownload24}" />
            </WrapPanel>
        </Border>

        <ui:InfoBar
            Grid.Row="2"
            Margin="0,12,0,0"
            IsClosable="False"
            IsOpen="{Binding ErrorMessage, Converter={StaticResource HasText}, Mode=OneWay}"
            Message="{Binding ErrorMessage}"
            Severity="Error" />

        <TabControl
            Grid.Row="3"
            Margin="0,12,0,0"
            SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="{l:Loc History_Tab_Messages}">
                <DataGrid
                    Margin="0,8,0,0"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding Messages}"
                    VirtualizingPanel.IsVirtualizing="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="140" Binding="{Binding M.DateCreated, Converter={StaticResource LocalTime}}" Header="{l:Loc Col_Date}" />
                        <DataGridTextColumn Width="130" Binding="{Binding To}" Header="{l:Loc Col_Phone}" />
                        <DataGridTextColumn Width="60" Binding="{Binding M.Type}" Header="{l:Loc Col_Type}" />
                        <DataGridTemplateColumn Width="100" Header="{l:Loc Col_Status}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:MessageRow}">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentPresenter Content="{Binding State}" ContentTemplate="{StaticResource StateDot}" />
                                        <TextBlock Text="{Binding StatusText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Width="70" Binding="{Binding M.StatusCode}" Header="{l:Loc Col_Code}" />
                        <DataGridTextColumn Width="150" Binding="{Binding M.Reason}" Header="{l:Loc Col_Reason}" />
                        <DataGridTextColumn Width="*" Binding="{Binding M.Text}" Header="{l:Loc Col_Message}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{l:Loc History_Tab_Groups}">
                <DataGrid
                    Margin="0,8,0,0"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding Groups}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="140" Binding="{Binding Date, Converter={StaticResource LocalTime}}" Header="{l:Loc Col_Date}" />
                        <DataGridTemplateColumn Width="120" Header="{l:Loc Col_Status}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:GroupRow}">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentPresenter Content="{Binding State}" ContentTemplate="{StaticResource StateDot}" />
                                        <TextBlock Text="{Binding StatusText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Width="90" Binding="{Binding Total, StringFormat={}{0:N0}}" Header="{l:Loc Col_Total}" />
                        <DataGridTextColumn Width="90" Binding="{Binding Success, StringFormat={}{0:N0}}" Header="{l:Loc Col_Success}" />
                        <DataGridTextColumn Width="90" Binding="{Binding Failed, StringFormat={}{0:N0}}" Header="{l:Loc Col_Failed}" />
                        <DataGridTextColumn Width="110" Binding="{Binding Cost, StringFormat={}{0:N0}원}" Header="{l:Loc Col_Cost}" />
                        <DataGridTextColumn Width="*" Binding="{Binding GroupId}" Header="Group ID" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <ui:ProgressRing
                Width="20"
                Height="20"
                HorizontalAlignment="Left"
                IsIndeterminate="True"
                Visibility="{Binding SearchCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
            <ui:Button
                HorizontalAlignment="Center"
                Command="{Binding LoadMoreCommand}"
                Content="{l:Loc History_LoadMore}" />
        </Grid>
    </Grid>
</Page>
