<Page
    x:Class="SolapiSender.UserApp.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="clr-namespace:SolapiSender.UserApp.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SolapiSender.UserApp.ViewModels.Pages"
    d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" Margin="32,24,32,32" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:Loc Settings_Title}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:Loc Settings_Subtitle}" />

            <!--  Giao diện  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Loc Settings_Appearance}" />
            <ui:CardControl Margin="0,0,0,8" Icon="{ui:SymbolIcon DarkTheme24}">
                <ui:CardControl.Header>
                    <TextBlock Text="{l:Loc Settings_Theme}" />
                </ui:CardControl.Header>
                <ComboBox
                    Width="180"
                    SelectedValue="{Binding Theme}"
                    SelectedValuePath="Tag">
                    <ComboBoxItem Content="{l:Loc Settings_Theme_System}" Tag="system" />
                    <ComboBoxItem Content="{l:Loc Settings_Theme_Light}" Tag="light" />
                    <ComboBoxItem Content="{l:Loc Settings_Theme_Dark}" Tag="dark" />
                </ComboBox>
            </ui:CardControl>
            <ui:CardControl Margin="0,0,0,20" Icon="{ui:SymbolIcon LocalLanguage24}">
                <ui:CardControl.Header>
                    <TextBlock Text="{l:Loc Settings_Language}" />
                </ui:CardControl.Header>
                <ComboBox
                    Width="180"
                    SelectedValue="{Binding Language}"
                    SelectedValuePath="Tag">
                    <ComboBoxItem Content="한국어" Tag="ko" />
                    <ComboBoxItem Content="Tiếng Việt" Tag="vi" />
                </ComboBox>
            </ui:CardControl>

            <!--  Gửi tin  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Loc Settings_Sending}" />
            <Border Margin="0,0,0,20" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Settings_LowBalance}" />
                            <ui:NumberBox
                                MaxDecimalPlaces="0"
                                Minimum="0"
                                SmallChange="1000"
                                Value="{Binding LowBalanceThreshold}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Compose_OptOut}" />
                            <ui:TextBox PlaceholderText="080-000-0000" Text="{Binding OptOutNumber, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Margin="0,16,0,6"
                        Style="{StaticResource FieldLabel}"
                        Text="{l:Loc Settings_Prices}" />
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource Caption}" Text="SMS" />
                            <ui:NumberBox MaxDecimalPlaces="1" Minimum="0" Value="{Binding PriceSms}" />
                        </StackPanel>
                        <StackPanel Margin="4,0">
                            <TextBlock Style="{StaticResource Caption}" Text="LMS" />
                            <ui:NumberBox MaxDecimalPlaces="1" Minimum="0" Value="{Binding PriceLms}" />
                        </StackPanel>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Style="{StaticResource Caption}" Text="MMS" />
                            <ui:NumberBox MaxDecimalPlaces="1" Minimum="0" Value="{Binding PriceMms}" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource Caption}"
                        Text="{l:Loc Settings_PricesHint}" />
                    <ui:Button
                        Margin="0,14,0,0"
                        HorizontalAlignment="Right"
                        Appearance="Primary"
                        Command="{Binding SaveCloudCommand}"
                        Content="{l:Loc Common_Save}"
                        Icon="{ui:SymbolIcon Save24}" />
                </StackPanel>
            </Border>

            <!--  SOLAPI  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="SOLAPI" />
            <ui:CardControl Margin="0,0,0,20" Icon="{ui:SymbolIcon Key24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="API Key" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding MaskedApiKey}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button
                    Command="{Binding ChangeApiKeyCommand}"
                    Content="{l:Loc Settings_ChangeKey}"
                    Icon="{ui:SymbolIcon Edit24}" />
            </ui:CardControl>

            <!--  Tài khoản  -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Loc Settings_Account}" />
            <Border Margin="0,0,0,8" Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Caption}" Text="{l:Loc Settings_Store}" />
                    <TextBlock Grid.Column="1" Text="{Binding StoreName}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Text="{l:Loc Login_Email}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Email}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Text="{l:Loc Settings_Expires}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ExpiresAt}" />
                    <TextBlock Grid.Row="3" Style="{StaticResource Caption}" Text="{l:Loc Settings_Devices}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Devices}" />
                    <TextBlock Grid.Row="4" Style="{StaticResource Caption}" Text="{l:Loc Settings_Version}" />
                    <TextBlock Grid.Row="4" Grid.Column="1">
                        <Run Text="{Binding Version, Mode=OneWay}" />
                        <Run Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding MachineIdShort, Mode=OneWay, StringFormat=· PC {0}}" />
                    </TextBlock>
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    Command="{Binding OpenLogsCommand}"
                    Content="{l:Loc Settings_OpenLogs}"
                    Icon="{ui:SymbolIcon Folder24}" />
                <ui:Button
                    Appearance="Danger"
                    Command="{Binding LogoutCommand}"
                    Content="{l:Loc Settings_Logout}"
                    Icon="{ui:SymbolIcon SignOut24}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
