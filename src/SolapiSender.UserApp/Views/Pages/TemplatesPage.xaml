<Page
    x:Class="SolapiSender.UserApp.Views.Pages.TemplatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fb="clr-namespace:SolapiSender.Core.Models.Firebase;assembly=SolapiSender.Core"
    xmlns:l="clr-namespace:SolapiSender.UserApp.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SolapiSender.UserApp.ViewModels.Pages"
    d:DataContext="{d:DesignInstance vm:TemplatesViewModel}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="3">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="{l:Loc Template_Title}" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:Loc Template_Subtitle}" />
            </StackPanel>
            <ui:Button
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Appearance="Primary"
                Command="{Binding NewCommand}"
                Content="{l:Loc Template_New}"
                Icon="{ui:SymbolIcon Add24}" />
        </Grid>

        <ui:InfoBar
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="{Binding ErrorMessage, Converter={StaticResource HasText}, Mode=OneWay}"
            Message="{Binding ErrorMessage}"
            Severity="Error" />

        <!--  Danh sách  -->
        <Border
            Grid.Row="2"
            Padding="6"
            Style="{StaticResource Card}">
            <Grid>
                <TextBlock
                    Margin="14"
                    Style="{StaticResource Caption}"
                    Text="{l:Loc Common_Empty}"
                    Visibility="{Binding Templates.Count, Converter={StaticResource BoolToCollapsed}}" />
                <ListBox
                    Background="Transparent"
                    BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ItemsSource="{Binding Templates}"
                    SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type fb:MessageTemplate}">
                            <StackPanel Margin="4,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <Border
                                        Margin="8,0,0,0"
                                        Padding="6,0"
                                        Style="{StaticResource Pill}"
                                        Visibility="{Binding IsAd, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock FontSize="11" Style="{StaticResource PillText}" Text="{l:Loc Template_AdBadge}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    MaxHeight="36"
                                    Margin="0,2,0,0"
                                    Style="{StaticResource Caption}"
                                    Text="{Binding Content}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!--  Trình soạn  -->
        <Border
            Grid.Row="2"
            Grid.Column="2"
            Style="{StaticResource Card}">
            <Grid>
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToCollapsed}}">
                    <ui:SymbolIcon
                        HorizontalAlignment="Center"
                        FontSize="40"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Symbol="DocumentText24" />
                    <TextBlock
                        Margin="0,10,0,0"
                        Style="{StaticResource Caption}"
                        Text="{l:Loc Template_SelectHint}" />
                </StackPanel>

                <DockPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Template_Name}" />
                        <ui:TextBox Margin="0,0,0,12" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Template_Subject}" />
                        <ui:TextBox
                            Margin="0,0,0,12"
                            PlaceholderText="{l:Loc Compose_SubjectHint}"
                            Text="{Binding EditSubject, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Template_Content}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <ui:Button
                                    Margin="0,0,10,0"
                                    Padding="8,2"
                                    Command="{Binding InsertNameCommand}"
                                    Content="#{이름}"
                                    FontSize="12" />
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding ByteInfo}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Grid Margin="0,14,0,0" DockPanel.Dock="Bottom">
                        <CheckBox Content="{l:Loc Template_IsAd}" IsChecked="{Binding EditIsAd}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <ui:Button
                                Margin="0,0,8,0"
                                Command="{Binding DeleteCommand}"
                                Content="{l:Loc Common_Delete}"
                                Icon="{ui:SymbolIcon Delete24}"
                                IsEnabled="{Binding HasSelection}" />
                            <ui:Button
                                MinWidth="120"
                                Appearance="Primary"
                                Command="{Binding SaveCommand}"
                                Content="{l:Loc Common_Save}"
                                Icon="{ui:SymbolIcon Save24}" />
                        </StackPanel>
                    </Grid>

                    <ui:TextBox
                        MinHeight="220"
                        AcceptsReturn="True"
                        Text="{Binding EditContent, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        VerticalContentAlignment="Top"
                        VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
