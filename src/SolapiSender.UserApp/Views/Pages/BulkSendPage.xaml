<Page
    x:Class="SolapiSender.UserApp.Views.Pages.BulkSendPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:SolapiSender.Core.Models;assembly=SolapiSender.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="clr-namespace:SolapiSender.UserApp.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SolapiSender.UserApp.ViewModels.Pages"
    d:DataContext="{d:DesignInstance vm:BulkSendViewModel}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,24,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.ColumnSpan="3">
                <TextBlock Style="{StaticResource PageTitle}" Text="{l:Loc BulkSend_Title}" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:Loc BulkSend_Subtitle}" />
            </StackPanel>

            <!--  ① Người nhận  -->
            <Border
                Grid.Row="1"
                VerticalAlignment="Top"
                Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Top"
                        Style="{StaticResource SectionTitle}"
                        Text="{l:Loc BulkSend_Step1}" />

                    <WrapPanel Margin="0,0,0,10" DockPanel.Dock="Top">
                        <ui:Button
                            Margin="0,0,8,6"
                            Appearance="Primary"
                            Command="{Binding ImportFileCommand}"
                            Content="{l:Loc BulkSend_ImportExcel}"
                            Icon="{ui:SymbolIcon DocumentTable24}" />
                        <ui:Button
                            Margin="0,0,8,6"
                            Command="{Binding TogglePasteCommand}"
                            Content="{l:Loc BulkSend_Paste}"
                            Icon="{ui:SymbolIcon ClipboardPaste24}" />
                        <ui:Button
                            Margin="0,0,8,6"
                            Command="{Binding RemoveInvalidCommand}"
                            Content="{l:Loc BulkSend_RemoveInvalid}"
                            Icon="{ui:SymbolIcon Dismiss24}" />
                        <ui:Button
                            Margin="0,0,0,6"
                            Command="{Binding ClearRecipientsCommand}"
                            Content="{l:Loc BulkSend_Clear}"
                            Icon="{ui:SymbolIcon Delete24}" />
                    </WrapPanel>

                    <!--  Dán danh sách  -->
                    <StackPanel
                        Margin="0,0,0,10"
                        DockPanel.Dock="Top"
                        Visibility="{Binding IsPasteOpen, Converter={StaticResource BoolToVisibility}}">
                        <ui:TextBox
                            Height="120"
                            AcceptsReturn="True"
                            PlaceholderText="{l:Loc BulkSend_PasteHint}"
                            Text="{Binding PasteText, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="NoWrap"
                            VerticalScrollBarVisibility="Auto" />
                        <ui:Button
                            Margin="0,8,0,0"
                            HorizontalAlignment="Right"
                            Appearance="Primary"
                            Command="{Binding AddPastedCommand}"
                            Content="{l:Loc BulkSend_AddPasted}"
                            Icon="{ui:SymbolIcon Add24}" />
                    </StackPanel>

                    <!--  Thống kê  -->
                    <UniformGrid
                        Margin="0,0,0,10"
                        Columns="4"
                        DockPanel.Dock="Top">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Loc BulkSend_Total}" />
                            <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Summary.Total, StringFormat={}{0:N0}}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Loc Recipient_Valid}" />
                            <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Text="{Binding Summary.Valid, StringFormat={}{0:N0}}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Loc Recipient_Duplicate}" />
                            <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding Summary.Duplicate, StringFormat={}{0:N0}}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{l:Loc Recipient_Invalid}" />
                            <TextBlock FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding Summary.Invalid, StringFormat={}{0:N0}}" />
                        </StackPanel>
                    </UniformGrid>

                    <DataGrid
                        Height="560"
                        VerticalAlignment="Top"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        EnableRowVirtualization="True"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding Recipients}"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="56" Binding="{Binding RowNumber}" Header="#" />
                            <DataGridTextColumn Width="140" Binding="{Binding DisplayPhone}" Header="{l:Loc Col_Phone}" />
                            <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="{l:Loc Col_Name}" />
                            <DataGridTemplateColumn Width="96" Header="{l:Loc Col_Status}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type core:Recipient}">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentPresenter Content="{Binding Status, Converter={StaticResource RecipientStatusState}}" ContentTemplate="{StaticResource StateDot}" />
                                            <TextBlock Text="{Binding Status, Converter={StaticResource RecipientStatusText}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="52">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type core:Recipient}">
                                        <ui:Button
                                            Padding="6,4"
                                            HorizontalAlignment="Center"
                                            Appearance="Transparent"
                                            Command="{Binding DataContext.RemoveRecipientCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Icon="{ui:SymbolIcon Delete24}"
                                            ToolTip="{l:Loc BulkSend_RemoveRow}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!--  ② Soạn tin + ③ Gửi  -->
            <StackPanel Grid.Row="1" Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Loc BulkSend_Step2}" />
                            <StackPanel
                                Margin="0,-4,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,6,0" Symbol="DocumentText24" />
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Caption}"
                                    Text="{l:Loc BulkSend_PickTemplate}" />
                                <ComboBox
                                    Width="200"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding Templates}"
                                    SelectedItem="{Binding SelectedTemplate}" />
                            </StackPanel>
                        </Grid>

                        <ui:TextBox
                            Margin="0,4,0,8"
                            PlaceholderText="{l:Loc Compose_SubjectHint}"
                            Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" />

                        <ui:TextBox
                            Height="190"
                            AcceptsReturn="True"
                            PlaceholderText="{l:Loc Compose_TextHint}"
                            Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            VerticalContentAlignment="Top"
                            VerticalScrollBarVisibility="Auto" />

                        <!--  Bộ đếm + biến  -->
                        <Grid Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Caption}"
                                    Text="{l:Loc Compose_InsertVariable}" />
                                <ItemsControl ItemsSource="{Binding AvailableVariables}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Button
                                                Margin="0,0,4,0"
                                                Padding="8,2"
                                                Command="{Binding DataContext.InsertVariableCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding}"
                                                ContentStringFormat="#{{{0}}}"
                                                FontSize="12" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Border Margin="0,0,8,0" Style="{StaticResource Pill}">
                                    <TextBlock Style="{StaticResource PillText}" Text="{Binding TypeLabel}" />
                                </Border>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ByteCount}" />
                                <TextBlock
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Caption}"
                                    Text="{Binding ByteLimitText}" />
                            </StackPanel>
                        </Grid>

                        <ui:InfoBar
                            Margin="0,8,0,0"
                            IsClosable="False"
                            IsOpen="{Binding UnsupportedWarning, Converter={StaticResource HasText}, Mode=OneWay}"
                            Message="{Binding UnsupportedWarning}"
                            Severity="Warning" />
                        <ui:InfoBar
                            Margin="0,8,0,0"
                            IsClosable="False"
                            IsOpen="{Binding ComposeError, Converter={StaticResource HasText}, Mode=OneWay}"
                            Message="{Binding ComposeError}"
                            Severity="Error" />

                        <!--  Ảnh MMS  -->
                        <Grid Margin="0,12,0,0">
                            <ui:Button
                                Command="{Binding PickImageCommand}"
                                Content="{l:Loc Compose_AttachImage}"
                                Icon="{ui:SymbolIcon Image24}" />
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Visibility="{Binding ImageInfo, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock VerticalAlignment="Center" Text="{Binding ImageInfo}" />
                                <ui:Button
                                    Margin="6,0,0,0"
                                    Appearance="Transparent"
                                    Command="{Binding RemoveImageCommand}"
                                    Icon="{ui:SymbolIcon Dismiss24}" />
                            </StackPanel>
                        </Grid>

                        <!--  Quảng cáo  -->
                        <Border
                            Margin="0,14,0,0"
                            Padding="14,10"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="6">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Margin="0,0,8,0" Symbol="Megaphone24" />
                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{l:Loc Compose_AdMode}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding IsAd}" />
                                </Grid>
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Style="{StaticResource Caption}"
                                    Text="{l:Loc Compose_AdHint}" />
                                <Grid Margin="0,10,0,0" Visibility="{Binding IsAd, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Compose_AdName}" />
                                        <ui:TextBox Text="{Binding AdSenderName, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Compose_OptOut}" />
                                        <ui:TextBox PlaceholderText="080-000-0000" Text="{Binding OptOutNumber, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--  Xem trước kiểu bong bóng tin nhắn  -->
                        <TextBlock
                            Margin="0,16,0,6"
                            Style="{StaticResource FieldLabel}"
                            Text="{l:Loc Compose_Preview}" />
                        <Border
                            MaxWidth="360"
                            Padding="14,10"
                            HorizontalAlignment="Left"
                            Visibility="{Binding PreviewText, Converter={StaticResource BoolToVisibility}}"
                            Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="14,14,14,4">
                            <TextBlock
                                LineHeight="20"
                                Text="{Binding PreviewText}"
                                TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!--  ③ Gửi  -->
                <Border Margin="0,16,0,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Loc BulkSend_Step3}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Send_From}" />
                                <ComboBox ItemsSource="{Binding Senders.Numbers}" SelectedItem="{Binding SelectedSender}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource PhoneDisplay}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{l:Loc Send_Schedule}" />
                                <ui:ToggleSwitch
                                    Height="34"
                                    IsChecked="{Binding IsScheduled}"
                                    OffContent="{l:Loc Send_Now}"
                                    OnContent="{l:Loc Send_Schedule}" />
                            </StackPanel>
                        </Grid>

                        <!--  Ngày giờ hẹn (giờ Hàn Quốc)  -->
                        <StackPanel
                            Margin="0,10,0,0"
                            Orientation="Horizontal"
                            Visibility="{Binding IsScheduled, Converter={StaticResource BoolToVisibility}}">
                            <DatePicker
                                Width="170"
                                SelectedDate="{Binding ScheduleDate}"
                                SelectedDateFormat="Short" />
                            <ComboBox
                                Width="80"
                                Margin="8,0,0,0"
                                ItemStringFormat="00"
                                ItemsSource="{Binding Hours}"
                                SelectedItem="{Binding ScheduleHour}" />
                            <TextBlock
                                Margin="6,0"
                                VerticalAlignment="Center"
                                Text=":" />
                            <ComboBox
                                Width="80"
                                ItemStringFormat="00"
                                ItemsSource="{Binding Minutes}"
                                SelectedItem="{Binding ScheduleMinute}" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource Caption}"
                                Text="KST" />
                        </StackPanel>

                        <Border
                            Margin="0,14,0,0"
                            Padding="14,10"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="6">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,10,0" Symbol="Money24" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding CostText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <StackPanel VerticalAlignment="Center" Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibility}}">
                                <ProgressBar Height="6" Margin="0,0,180,6" Maximum="100" Value="{Binding Progress}" />
                                <TextBlock Style="{StaticResource Caption}" Text="{Binding ProgressText}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Command="{Binding CancelSendCommand}"
                                    Content="{l:Loc Common_Cancel}"
                                    Icon="{ui:SymbolIcon Stop24}"
                                    Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button
                                    Height="40"
                                    MinWidth="160"
                                    Appearance="Primary"
                                    Command="{Binding SendCommand}"
                                    Content="{l:Loc Send_Button}"
                                    Icon="{ui:SymbolIcon Send24}"
                                    IsEnabled="{Binding IsSending, Converter={StaticResource InverseBool}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!--  Kết quả  -->
            <Border
                x:Name="ResultsCard"
                Grid.Row="2"
                Grid.ColumnSpan="3"
                Margin="0,16,0,0"
                Style="{StaticResource Card}"
                Visibility="{Binding ResultSummary, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Loc Send_Results}" />
                            <TextBlock Margin="0,-6,0,10" Style="{StaticResource Caption}" Text="{Binding ResultSummary}" />
                        </StackPanel>
                        <ui:Button
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Command="{Binding ExportResultsCommand}"
                            Content="{l:Loc Common_ExportExcel}"
                            Icon="{ui:SymbolIcon ArrowDownload24}" />
                    </Grid>
                    <DataGrid
                        Height="320"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding Results}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="120" Header="{l:Loc Col_Result}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:SendResultRow}">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentPresenter Content="{Binding StateKey}" ContentTemplate="{StaticResource StateDot}" />
                                            <TextBlock Text="{Binding State, Converter={StaticResource SendStateText}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="150" Binding="{Binding Phone}" Header="{l:Loc Col_Phone}" />
                            <DataGridTextColumn Width="160" Binding="{Binding Name}" Header="{l:Loc Col_Name}" />
                            <DataGridTextColumn Width="90" Binding="{Binding StatusCode}" Header="{l:Loc Col_Code}" />
                            <DataGridTextColumn Width="*" Binding="{Binding Message}" Header="{l:Loc Col_Message}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
