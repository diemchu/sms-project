<ui:FluentWindow
    x:Class="SolapiSender.UserApp.Views.ConnectSolapiWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:l="clr-namespace:SolapiSender.UserApp.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SolapiSender.UserApp.ViewModels"
    Title="{l:Loc Connect_Title}"
    Width="620"
    Height="640"
    d:DataContext="{d:DesignInstance vm:ConnectSolapiViewModel}"
    ExtendsContentIntoTitleBar="True"
    FontFamily="{DynamicResource AppFont}"
    ResizeMode="NoResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="SOLAPI Sender" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="40,8,40,32">
            <Border
                Width="52"
                Height="52"
                HorizontalAlignment="Left"
                Background="{DynamicResource AccentFillColorDefaultBrush}"
                CornerRadius="14">
                <ui:SymbolIcon
                    FontSize="28"
                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                    Symbol="Key24" />
            </Border>
            <TextBlock
                Margin="0,18,0,4"
                Style="{StaticResource PageTitle}"
                Text="{l:Loc Connect_Title}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:Loc Connect_Subtitle}" />

            <Border Margin="0,0,0,18" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:Loc Connect_HowTo}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{l:Loc Connect_HowToSteps}" LineHeight="20" />
                    <ui:Button
                        Margin="0,10,0,0"
                        Appearance="Secondary"
                        Command="{Binding OpenConsoleCommand}"
                        Content="{l:Loc Connect_OpenConsole}"
                        Icon="{ui:SymbolIcon Open24}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource FieldLabel}" Text="API Key" />
            <ui:TextBox
                Margin="0,0,0,14"
                Icon="{ui:SymbolIcon Key24}"
                PlaceholderText="NCS..."
                Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="API Secret" />
            <ui:PasswordBox
                x:Name="SecretInput"
                Margin="0,0,0,8"
                Icon="{ui:SymbolIcon LockClosed24}"
                PasswordChanged="OnSecretChanged" />
            <TextBlock
                Margin="0,0,0,16"
                Style="{StaticResource Caption}"
                Text="{l:Loc Connect_Security}" />

            <ui:InfoBar
                Margin="0,0,0,12"
                IsClosable="False"
                IsOpen="{Binding ErrorMessage, Converter={StaticResource HasText}, Mode=OneWay}"
                Message="{Binding ErrorMessage}"
                Severity="Error" />
            <ui:InfoBar
                Margin="0,0,0,12"
                IsClosable="False"
                IsOpen="{Binding SuccessMessage, Converter={StaticResource HasText}, Mode=OneWay}"
                Message="{Binding SuccessMessage}"
                Severity="Success" />

            <Grid>
                <ui:Button
                    Command="{Binding CancelCommand}"
                    Content="{l:Loc Connect_Cancel}" />
                <ui:Button
                    Height="38"
                    MinWidth="180"
                    HorizontalAlignment="Right"
                    Appearance="Primary"
                    Command="{Binding VerifyCommand}"
                    IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <ui:ProgressRing
                            Width="16"
                            Height="16"
                            Margin="0,0,8,0"
                            IsIndeterminate="True"
                            Visibility="{Binding VerifyCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{l:Loc Connect_Verify}" />
                    </StackPanel>
                </ui:Button>
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
