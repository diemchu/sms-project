<Page
    x:Class="SolapiSender.AdminTool.Views.Pages.UsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svc="clr-namespace:SolapiSender.AdminTool.Services"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SolapiSender.AdminTool.ViewModels"
    d:DataContext="{d:DesignInstance vm:UsersViewModel}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Người dùng" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="Tài khoản chủ quán: thêm, sửa, gia hạn, khóa và quản lý PC đã đăng ký." />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                <ui:Button Margin="0,0,8,0" Command="{Binding RefreshCommand}" Content="Làm mới" Icon="{ui:SymbolIcon ArrowSync24}" />
                <ui:Button Appearance="Primary" Command="{Binding AddCommand}" Content="Thêm người dùng" Icon="{ui:SymbolIcon PersonAdd24}" />
            </StackPanel>
        </Grid>

        <!--  Thống kê  -->
        <UniformGrid Grid.Row="1" Margin="-6,0,-6,12" Columns="5">
            <Border Margin="6" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="Tổng" />
                    <TextBlock Style="{StaticResource StatValue}" Text="{Binding TotalCount}" />
                </StackPanel>
            </Border>
            <Border Margin="6" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="Hoạt động" />
                    <TextBlock Style="{StaticResource StatValue}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Text="{Binding ActiveCount}" />
                </StackPanel>
            </Border>
            <Border Margin="6" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="Sắp hết hạn (≤ 7 ngày)" />
                    <TextBlock Style="{StaticResource StatValue}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding SoonCount}" />
                </StackPanel>
            </Border>
            <Border Margin="6" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="Đã hết hạn" />
                    <TextBlock Style="{StaticResource StatValue}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding ExpiredCount}" />
                </StackPanel>
            </Border>
            <Border Margin="6" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="Đã khóa" />
                    <TextBlock Style="{StaticResource StatValue}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding LockedCount}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!--  Tìm kiếm  -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Icon="{ui:SymbolIcon Search24}" PlaceholderText="Tìm theo tên cửa hàng, email, số điện thoại"
                        Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Grid.Column="2" DisplayMemberPath="Label" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" />
            <ui:ProgressRing Grid.Column="3" Width="20" Height="20" Margin="12,0" HorizontalAlignment="Left" IsIndeterminate="True"
                             Visibility="{Binding RefreshCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <ui:InfoBar Grid.Row="3" Margin="0,0,0,12" IsClosable="False"
                    IsOpen="{Binding ErrorMessage, Converter={StaticResource HasText}, Mode=OneWay}"
                    Message="{Binding ErrorMessage}" Severity="Error" />

        <DataGrid
            Grid.Row="4"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            HeadersVisibility="Column"
            IsReadOnly="True"
            ItemsSource="{Binding Users}"
            SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="130" Header="Trạng thái">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type svc:AdminUser}">
                            <StackPanel Margin="4,0" VerticalAlignment="Center" Orientation="Horizontal">
                                <ContentPresenter Content="{Binding StateKey}" ContentTemplate="{StaticResource StateDot}" />
                                <TextBlock Text="{Binding StatusText}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="*" MinWidth="150" Binding="{Binding StoreName}" Header="Cửa hàng" />
                <DataGridTextColumn Width="1.3*" MinWidth="180" Binding="{Binding Email}" Header="Email" />
                <DataGridTextColumn Width="125" Binding="{Binding PhoneText}" Header="Điện thoại" />
                <DataGridTextColumn Width="215" Binding="{Binding ExpiresText}" Header="Hết hạn" />
                <DataGridTextColumn Width="70" Binding="{Binding DevicesText}" Header="PC" />
                <DataGridTextColumn Width="130" Binding="{Binding LastSignInAt, Converter={StaticResource LocalTime}}" Header="Đăng nhập cuối" />
                <DataGridTemplateColumn Width="150" Header="">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type svc:AdminUser}">
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <ui:Button Margin="0,0,2,0" Padding="6" Appearance="Transparent"
                                           Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}" Icon="{ui:SymbolIcon Edit24}" ToolTip="Sửa / gia hạn / thiết bị" />
                                <ui:Button Margin="0,0,2,0" Padding="6" Appearance="Transparent"
                                           Command="{Binding DataContext.ToggleLockCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}" Icon="{ui:SymbolIcon LockClosed24}" ToolTip="Khóa / mở khóa" />
                                <ui:Button Margin="0,0,2,0" Padding="6" Appearance="Transparent"
                                           Command="{Binding DataContext.ShowLogsCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}" Icon="{ui:SymbolIcon History24}" ToolTip="Nhật ký hoạt động" />
                                <ui:Button Padding="6" Appearance="Transparent"
                                           Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}" Icon="{ui:SymbolIcon Delete24}" ToolTip="Xóa vĩnh viễn" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
