<Page
    x:Class="SolapiSender.AdminTool.Views.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SolapiSender.AdminTool.ViewModels"
    d:DataContext="{d:DesignInstance vm:LogsViewModel}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="Nhật ký hoạt động" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Các sự kiện do UserApp ghi lại: đăng nhập, kết nối API, gửi/hẹn giờ, lỗi." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <WrapPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Người dùng" />
                    <ComboBox Width="260" DisplayMemberPath="Label" ItemsSource="{Binding UserOptions}" SelectedItem="{Binding SelectedUser}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Từ ngày" />
                    <DatePicker Width="140" SelectedDate="{Binding FromDate}" SelectedDateFormat="Short" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Đến ngày" />
                    <DatePicker Width="140" SelectedDate="{Binding ToDate}" SelectedDateFormat="Short" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Loại" />
                    <ComboBox Width="140" DisplayMemberPath="Label" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding TypeFilter}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Tối đa" />
                    <ComboBox Width="90" ItemsSource="{Binding Limits}" SelectedItem="{Binding Limit}" />
                </StackPanel>
                <ui:Button Margin="0,0,8,0" VerticalAlignment="Bottom" Appearance="Primary" Command="{Binding SearchCommand}"
                           Content="Xem" Icon="{ui:SymbolIcon Search24}" />
                <ui:Button VerticalAlignment="Bottom" Command="{Binding ExportCommand}" Content="Xuất Excel" Icon="{ui:SymbolIcon ArrowDownload24}" />
            </WrapPanel>
        </Border>

        <ui:InfoBar Grid.Row="2" Margin="0,12,0,0" IsClosable="False"
                    IsOpen="{Binding ErrorMessage, Converter={StaticResource HasText}, Mode=OneWay}"
                    Message="{Binding ErrorMessage}" Severity="Error" />

        <DataGrid Grid.Row="3" Margin="0,12,0,0" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                  IsReadOnly="True" ItemsSource="{Binding Logs}">
            <DataGrid.Columns>
                <DataGridTextColumn Width="140" Binding="{Binding CreatedAt, Converter={StaticResource LocalTime}}" Header="Thời gian" />
                <DataGridTextColumn Width="200" Binding="{Binding UserLabel}" Header="Cửa hàng" />
                <DataGridTextColumn Width="100" Binding="{Binding Type}" Header="Loại" />
                <DataGridTextColumn Width="200" Binding="{Binding Message}" Header="Nội dung" />
                <DataGridTextColumn Width="130" Binding="{Binding MachineId}" Header="Máy" />
                <DataGridTextColumn Width="*" Binding="{Binding MetaText}" Header="Chi tiết" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource Caption}" Text="{Binding CountText}" />
            <ui:ProgressRing Width="18" Height="18" HorizontalAlignment="Right" IsIndeterminate="True"
                             Visibility="{Binding SearchCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Grid>
</Page>
