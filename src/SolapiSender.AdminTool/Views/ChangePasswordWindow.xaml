<ui:FluentWindow
    x:Class="SolapiSender.AdminTool.Views.ChangePasswordWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SolapiSender.AdminTool.ViewModels"
    Title="Đổi mật khẩu"
    Width="460"
    Height="600"
    d:DataContext="{d:DesignInstance vm:ChangePasswordViewModel}"
    ExtendsContentIntoTitleBar="True"
    FontFamily="{DynamicResource AppFont}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ResizeMode="NoResize"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <ui:TitleBar Title="" VerticalAlignment="Top" ShowMaximize="False" ShowMinimize="False" />
        <StackPanel Margin="44,48,44,24" VerticalAlignment="Top">
            <TextBlock Style="{StaticResource PageTitle}" Text="Đổi mật khẩu" />
            <ui:InfoBar
                Title="Bắt buộc"
                Margin="0,6,0,12"
                IsClosable="False"
                IsOpen="{Binding Mandatory, Mode=OneWay}"
                Message="Đây là lần đăng nhập đầu tiên với mật khẩu mặc định. Hãy đặt mật khẩu mới để tiếp tục."
                Severity="Warning" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Mật khẩu hiện tại" />
            <ui:PasswordBox x:Name="CurrentInput" Margin="0,0,0,12" PasswordChanged="OnPasswordChanged" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Mật khẩu mới" />
            <ui:PasswordBox x:Name="NewInput" Margin="0,0,0,12" PasswordChanged="OnPasswordChanged" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Nhập lại mật khẩu mới" />
            <ui:PasswordBox x:Name="ConfirmInput" Margin="0,0,0,8" PasswordChanged="OnPasswordChanged" />
            <TextBlock Margin="0,0,0,12" Style="{StaticResource Caption}"
                       Text="Ít nhất 10 ký tự, có cả chữ và số, không chứa tên đăng nhập hoặc chữ &quot;admin&quot;." />

            <ui:InfoBar
                Margin="0,0,0,12"
                IsClosable="False"
                IsOpen="{Binding ErrorMessage, Converter={StaticResource HasText}, Mode=OneWay}"
                Message="{Binding ErrorMessage}"
                Severity="Error" />

            <Grid>
                <ui:Button Command="{Binding CancelCommand}" Content="Hủy" />
                <ui:Button MinWidth="150" HorizontalAlignment="Right" Appearance="Primary" Command="{Binding SaveCommand}"
                           Content="Lưu mật khẩu" IsDefault="True" />
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
