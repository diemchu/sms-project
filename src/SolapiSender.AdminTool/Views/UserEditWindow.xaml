<ui:FluentWindow
    x:Class="SolapiSender.AdminTool.Views.UserEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svc="clr-namespace:SolapiSender.AdminTool.Services"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:SolapiSender.AdminTool.ViewModels"
    Title="{Binding Title}"
    Width="720"
    Height="780"
    d:DataContext="{d:DesignInstance vm:UserEditViewModel}"
    ExtendsContentIntoTitleBar="True"
    FontFamily="{DynamicResource AppFont}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="{Binding Title}" ShowMaximize="False" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="32,4,32,12">
                <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
                <TextBlock Margin="0,0,0,16" Style="{StaticResource Caption}" Text="{Binding UidText}" />

                <!--  Tài khoản đăng nhập  -->
                <Border Margin="0,0,0,12" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Tài khoản đăng nhập" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Email" />
                        <ui:TextBox Margin="0,0,0,12" Icon="{ui:SymbolIcon Mail24}" PlaceholderText="shop@example.com"
                                    Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Mật khẩu" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Icon="{ui:SymbolIcon Key24}" PlaceholderText="Để trống nếu không đổi"
                                        Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding NewPasswordCommand}"
                                       Content="Tạo ngẫu nhiên" Icon="{ui:SymbolIcon ArrowSync24}" />
                        </Grid>
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}"
                                   Text="Khi sửa: nhập mật khẩu mới sẽ đổi mật khẩu và đăng xuất mọi máy của người dùng." />
                    </StackPanel>
                </Border>

                <!--  Cửa hàng  -->
                <Border Margin="0,0,0,12" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="3" Style="{StaticResource SectionTitle}" Text="Cửa hàng" />
                        <StackPanel Grid.Row="1">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Tên cửa hàng" />
                            <ui:TextBox Icon="{ui:SymbolIcon BuildingShop24}" PlaceholderText="행복폰 강남점"
                                        Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Số điện thoại" />
                            <ui:TextBox Icon="{ui:SymbolIcon Phone24}" PlaceholderText="010-0000-0000"
                                        Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Giấy phép  -->
                <Border Margin="0,0,0,12" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Quyền sử dụng" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Hết hạn (cuối ngày, giờ Hàn Quốc)" />
                                <DatePicker SelectedDate="{Binding ExpiresDate}" SelectedDateFormat="Short" />
                            </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="5" Margin="0,8,0,0" Orientation="Horizontal">
                                    <ui:Button Margin="0,0,6,0" Command="{Binding ExtendCommand}" CommandParameter="1" Content="+1 tháng" />
                                    <ui:Button Margin="0,0,6,0" Command="{Binding ExtendCommand}" CommandParameter="3" Content="+3 tháng" />
                                    <ui:Button Margin="0,0,6,0" Command="{Binding ExtendCommand}" CommandParameter="6" Content="+6 tháng" />
                                    <ui:Button Command="{Binding ExtendCommand}" CommandParameter="12" Content="+1 năm" />
                                </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Số PC tối đa" />
                                <ui:NumberBox MaxDecimalPlaces="0" Maximum="20" Minimum="1" Value="{Binding MaxDevices}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Trạng thái" />
                                <ui:ToggleSwitch Height="34" IsChecked="{Binding IsActive}" OffContent="Đã khóa" OnContent="Hoạt động" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Thiết bị (chỉ khi sửa)  -->
                <Border Style="{StaticResource Card}" Visibility="{Binding IsNew, Converter={StaticResource BoolToCollapsed}}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="PC đã đăng ký" />
                            <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding ResetDevicesCommand}"
                                       Content="Gỡ tất cả" Icon="{ui:SymbolIcon Delete24}" />
                        </Grid>
                        <TextBlock Margin="0,4" Style="{StaticResource Caption}" Text="Chưa có PC nào."
                                   Visibility="{Binding Devices.Count, Converter={StaticResource BoolToCollapsed}}" />
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type svc:AdminDevice}">
                                    <Border Padding="0,8" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Margin="0,0,12,0" FontSize="20" Symbol="Desktop24" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run Text="{Binding MachineName, Mode=OneWay}" />
                                                    <Run Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding AppVersion, Mode=OneWay, StringFormat=v{0}}" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource Caption}">
                                                    <Run Text="Lần cuối:" />
                                                    <Run Text="{Binding LastSeenAt, Mode=OneWay, Converter={StaticResource LocalTime}}" />
                                                    <Run Text="· ID" />
                                                    <Run Text="{Binding MachineId, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <ui:Button Grid.Column="2" Appearance="Transparent"
                                                       Command="{Binding DataContext.RemoveDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       CommandParameter="{Binding}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Gỡ thiết bị" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="32,8,32,24">
            <ui:InfoBar Margin="0,0,330,0" IsClosable="False"
                        IsOpen="{Binding ErrorMessage, Converter={StaticResource HasText}, Mode=OneWay}"
                        Message="{Binding ErrorMessage}" Severity="Error" />
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                <ui:Button Margin="0,0,8,0" Command="{Binding CancelCommand}" Content="Hủy" />
                <ui:Button MinWidth="140" Appearance="Primary" Command="{Binding SaveCommand}" Icon="{ui:SymbolIcon Save24}">
                    <StackPanel Orientation="Horizontal">
                        <ui:ProgressRing Width="14" Height="14" Margin="0,0,8,0" IsIndeterminate="True"
                                         Visibility="{Binding SaveCommand.IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="Lưu" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
